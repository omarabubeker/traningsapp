# Kopiera till .env.local lokalt. I Vercel: Settings → Environment Variables
# (lägg in för både Production och Preview). Inga hemligheter i koden.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "Publishable key" (sb_publishable_…) eller äldre "anon public"-nyckel
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Inloggning ---
# Bara den här adressen kan logga in (flera kan kommaseparereras)
ALLOWED_EMAIL=din@epost.se

# --- Kommer i senare etapper ---
# Etapp 2: intervals.icu (Settings → Developer Settings)
# INTERVALS_API_KEY=
# INTERVALS_ATHLETE_ID=i12345
# Etapp 3: Claude (platform.claude.com → API Keys)
# ANTHROPIC_API_KEY=
